[Unit]
Description=VM data maintenance v2 (%i)
After=local-fs.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
ExecStart=/usr/local/sbin/vm-data-maintenance-v2.sh --mode %i
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1h
StandardOutput=journal
StandardError=journal
